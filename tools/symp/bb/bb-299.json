   "sub": [
    {
     "id": "bb-299-bil",
     "h": "Bilateral",
     "html": "<div class=\"flow\" data-flow=\"b299a\"></div><div class=\"pearl\"><p><b>Clinical Pearl:</b></p><ul><li>Patients with bilateral acute vision loss should have a CT.</li></ul></div>"
    },
    {
     "id": "bb-299-uni",
     "h": "Unilateral",
     "html": "<div class=\"flow\" data-flow=\"b299b\"></div><div class=\"pearl\"><p><b>Clinical Pearls:</b></p><ul><li>Optic neuritis causes pain with EOM</li><li>Temporal arteritis causes temporalis pain and pain with mastication</li><li>Acute angle closure glaucoma causes high intraocular pressure, unilateral eye pain, mid-dilated pupil and n/v</li><li>Retinal detachment can present as a veil over the vision and with flashes and floaters.</li><li>TIA, vein or artery occlusion requires stroke work-up</li></ul></div>"
    }
   ]
  }
 ],
