     "t": "Reactive",
     "d": "<p>Reactive erythematous with various morphology</p>"
    },
    {
     "id": "d1",
     "k": "dx",
     "t": "Psoriasis",
     "d": "<p>Well demarcated plaques, thick silvery scale on elbows &amp; knees. Auspitz sign. Koebner's phenomenon</p>"
    },
    {
     "id": "d2",
     "k": "dx",
     "t": "Lichen Planus",
     "d": "<p>Purple, pruritic, polygonal, planar (flat-topped) papules on wrists/ankles/genitals (especially penis). Wickham's striae. Koebner's phenomenon</p>"
    },
    {
     "id": "d3",
     "k": "dx",
     "t": "Pityriasis Rosea",
     "d": "<p>Oval, tannish-pink or salmon-coloured patches, plaques with scaling border in Christmas tree pattern on trunk, begins with a large lesion patch (Herald's patch)</p>"
    },
    {
     "id": "d4",
     "k": "dx",
     "t": "Tinea (Ring Worm)",
     "d": "<p>Annular (Ring-shaped) lesion with elevated scaling, red border, central clearing</p>"
    },
    {
     "id": "d5",
     "k": "dx",
     "t": "Secondary Syphilis",
     "d": "<p>Red brown or copper coloured scaling papules and plaques on palms and soles</p>"
    },
    {
     "id": "d6",
     "k": "dx",
     "t": "Discoid Lupus Erythematous",
     "d": "<p>Scarring and/or atrophic red/purple plaques with white adherent scales on sun-exposed area</p>"
    }
   ],
