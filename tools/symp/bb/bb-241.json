  {
   "id": "b241a",
   "title": "Skin Rash — Eczematous",
   "src": "fig",
   "img": "bb-241-f1.webp",
   "nodes": [
    {
     "id": "a",
     "k": "start",
     "t": "Skin Rash"
    },
    {
     "id": "c0",
     "k": "q",
     "t": "Eczematous",
     "d": "<p>Pruritic/Scaly/Erythematous lesions. Usually poorly demarcated</p>"
    },
    {
     "id": "c1",
     "k": "q",
     "t": "Papulosquamous",
     "d": "<p>Erythematous or violaceous papules &amp; plaques with overlying scale</p>"
    },
    {
     "id": "c2",
     "k": "q",
     "t": "Vesiculobullous",
     "d": "<p>Blisters containing non-purulent fluid</p>"
    },
    {
     "id": "c3",
     "k": "q",
     "t": "Pustular",
     "d": "<p>Blisters containing purulent fluid</p>"
    },
    {
     "id": "c4",
     "k": "q",
     "t": "Reactive",
     "d": "<p>Reactive erythematous with various morphology</p>"
    },
    {
     "id": "d1",
     "k": "dx",
     "t": "Atopic Dermatitis (Eczema)",
     "d": "<p>Erythematous papules and vesicles (acute) or lichenification (chronic)</p><p><b>Age dependent distribution:</b></p><ul><li><u>Infants:</u> scalp, face, extensor extremities</li><li><u>Children:</u> flexural areas</li><li><u>Adults:</u> flexural areas/hands/face/nipples</li></ul>"
    },
    {
     "id": "d2",
     "k": "dx",
     "t": "Nummular Dermatitis (Discoid Eczema)",
     "d": "<p>Coin shaped (discoid) erythematous plaques. Usually on lower legs</p>"
    },
    {
     "id": "d3",
     "k": "dx",
     "t": "Seborrheic Dermatitis",
     "d": "<p>Yellowish-red plaques with greasy distinct margins on scalp/face/central chest folds</p>"
    },
    {
     "id": "d4",
     "k": "dx",
     "t": "Stasis Dermatitis",
     "d": "<p>Erythematous eruption on lower legs. Secondary to venous insufficiency. +/- pigmentation, edema, varicose veins, venous ulcers</p>"
    },
    {
     "id": "d5",
     "k": "dx",
     "t": "Dyshidrotic Eczema (pompholyx)",
     "d": "<p>Deep-Seated tapioca-like vesicles on hands/feet/sides of digits.</p>"
    },
    {
     "id": "d6",
     "k": "q",
     "t": "Contact Dermatitis",
     "d": "<p>Well-demarcated erythema, papules, vesicles, erosions scaling confined to area of contact</p>"
    },
    {
     "id": "e1",
     "k": "dx",
     "t": "Irritant",
     "d": "<p>Rapid onset, requires high doses of the agent. May occur in anyone</p>"
    },
    {
     "id": "e2",
     "k": "dx",
     "t": "Allergic",
     "d": "<p>Delayed onset (12-72 hrs). Very low concentrations sufficient. Occurs only in those sensitized</p>"
    }
   ],
