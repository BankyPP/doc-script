     "t": "Eczematous",
     "d": "<p>Pruritic/Scaly/Erythematous lesions. Usually poorly demarcated</p>"
    },
    {
     "id": "c1",
     "k": "q",
     "t": "Papulosquamous",
     "d": "<p>Erythematous or violaceous papules &amp; plaques with overlying scale</p>"
    },
    {
     "id": "c2",
     "k": "q",
