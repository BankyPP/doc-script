  {
   "op": "append",
   "sec": "cause",
   "html": "<h5>Causes of arrhythmia (Blackbook)</h5><p>May present as: palpitations, dizziness, syncope, chest discomfort</p><ul><li><b>Cardiac</b><ul><li><b>Structural</b>: Valve disease; Cardiomyopathy</li><li><b>Electrical conduction abnormalities</b>: Ectopic foci; Accessory pathway; Scar tissue (previous MI)</li></ul></li><li><b>Non-cardiac</b><ul><li><b>High output state</b>: Anemia; Fever/infection; Pregnancy</li><li><b>Metabolic</b>: Hypoglycemia; Thyrotoxicosis; Pheochromocytoma</li><li><b>Drugs</b>: Alcohol; Caffeine; Sympathomimetics; Anticholinergics; Cocaine</li><li><b>Psychiatric</b>: Panic Attack; Generalized Anxiety Disorder</li></ul></li></ul>"
  }
 ],
 "flows": [
  {
   "id": "b003a",
   "title": "Abnormal Rhythm (1) — Types of Arrhythmia",
   "src": "fig",
   "img": "bb-003-f1.webp",
   "nodes": [
    {
     "id": "a",
     "k": "start",
     "t": "Types of Arrhythmia"
    },
    {
     "id": "b",
     "k": "dx",
     "t": "Bradyarrhythmia (&lt;60 bpm)",
     "d": "<ul><li>Sinus Bradycardia</li><li>Sick Sinus Syndrome</li><li>SA Block</li><li>AV Block (1<sup>st</sup>/2<sup>nd</sup>/3<sup>rd</sup> degree)</li><li>Junctional Escape Rhythm</li><li>Ventricular Escape Rhythm</li></ul>"
    },
    {
     "id": "c",
     "k": "dx",
     "t": "Abnormal Beats",
     "d": "<ul><li>Premature atrial contraction</li><li>Premature ventricular contraction</li></ul>"
    },
    {
     "id": "d",
     "k": "q",
     "t": "Tachyarrhythmia (&gt;100 bpm)"
    },
    {
     "id": "e",
     "k": "q",
     "t": "Narrow QRS (&lt;120 msec) — SVT"
    },
    {
     "id": "f",
     "k": "q",
     "t": "Wide QRS (&gt;120 msec) — VT or SVT with aberrancy"
    },
    {
     "id": "g",
     "k": "dx",
     "t": "Regular Rhythm SVT (constant R-R interval)",
     "d": "<ul><li>Sinus Tachycardia</li><li>Monofocal Ectopic Atrial Tachycardia</li><li>Aflutter</li><li>AVNRT</li><li>AVRT (ie. WPW)</li></ul>"
    },
    {
     "id": "h",
     "k": "dx",
     "t": "Irregular Rhythm SVT (variable R-R interval)",
     "d": "<ul><li>AFib</li><li>AFlutter with Variable AV Conduction</li><li>Multifocal Atrial Tachycardia</li></ul>"
    },
    {
     "id": "i",
     "k": "dx",
     "t": "Regular Rhythm (constant R-R interval)",
     "d": "<ul><li>Monomorphic VT</li><li>Regular rhythm SVT with conduction aberrancy</li></ul>"
    },
    {
     "id": "j",
     "k": "dx",
     "t": "Irregular Rhythm (variable R-R interval)",
     "d": "<ul><li>Polymorphic VT (including Torsades de Pointes if in a setting of long QT)</li><li>Irregular rhythm SVT with conduction aberrancy</li></ul>"
    }
   ],
