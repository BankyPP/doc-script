     "id": "clr",
     "k": "q",
     "t": "Decreased bilirubin clearance",
     "d": "<ul><li><b>Breast milk Jaundice*</b></li><li>Gilbert’s</li><li>Crigler Najar</li></ul>"
    },
    {
     "id": "ent",
     "k": "q",
     "t": "Increased enterohepatic circulation",
     "d": "<ul><li>GI obstruction</li><li><b>Breast feeding jaundice/dehydration*</b></li></ul>"
