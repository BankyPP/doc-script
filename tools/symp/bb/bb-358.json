     "d": "<ul><li>Onset within first week of life, never in first 24 hours</li><li>Clinically well</li></ul>"
    },
    {
     "id": "pat",
     "k": "dx",
     "t": "Pathologic",
     "d": "<ul><li>Onset anytime within first week of life</li><li>Red flags: Onset first 24 hrs of life, clinically unwell, risk factors present</li></ul>"
    },
