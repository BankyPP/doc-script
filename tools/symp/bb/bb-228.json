  {
   "id": "bb-228-hyper",
   "h": "Hyperpigmentation",
   "html": "<div class=\"flow\" data-flow=\"b228a\"></div><div class=\"tbl\"><table><thead><tr><th>Group</th><th>Causes</th></tr></thead><tbody><tr><td><b>Hypopigmentation</b></td><td>ดูหน้า Hypopigmentation</td></tr><tr><td><b>Diffuse</b></td><td><ul><li>Tanning</li><li>Adverse cutaneous drug eruption</li><li>Addison's disease</li><li>Hemochromatosis</li><li>Porphyria cutanea tarda</li></ul></td></tr><tr><td><b>Congenital</b></td><td><ul><li>Café au lait macules (neurofibromatosis or McCune Albright syndrome)</li><li>Congenital melanocytic nevi</li></ul></td></tr><tr><td><b>Acquired</b></td><td><ul><li>Freckles (ephelides)</li><li>Lentigines</li><li>Melasma</li><li>Tinea versicolor (more commonly hypopigmented)</li><li>Post-Inflammatory hyperpigmentation</li></ul></td></tr></tbody></table></div>"
  },
  {
   "id": "bb-228-hypo",
   "h": "Hypopigmentation",
   "html": "<div class=\"flow\" data-flow=\"b228b\"></div><div class=\"tbl\"><table><thead><tr><th>Group</th><th>Causes</th></tr></thead><tbody><tr><td><b>Hyperpigmentation</b></td><td>ดูหน้า Hyperpigmentation</td></tr><tr><td><b>Congenital (localized)</b></td><td><ul><li>Tuberous sclerosis (white \"ash leaf\" macules)</li></ul></td></tr><tr><td><b>Congenital (diffuse)</b></td><td><p>Generalized hypopigmentation of hair, eyes, skin</p><ul><li>Phenylketonuria</li><li>Albinism</li><li>Piebaldism</li></ul></td></tr><tr><td><b>Acquired (diffuse)</b></td><td><ul><li>Vitiligo</li></ul></td></tr><tr><td><b>Scale</b></td><td><ul><li>Tinea versicolor (can also be hyperpigmented)</li><li>Pityriasis alba</li></ul></td></tr><tr><td><b>Acquired (sub-group)</b></td><td><ul><li>Vitiligo</li><li>Post-Inflammatory hypopigmentation</li></ul></td></tr></tbody></table></div>"
  }
 ],
